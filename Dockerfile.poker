# Neon Hold'em 牌桌即時伺服器（Socket.io）— 部署至 Railway / Fly 等常駐主機
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
# 正式依賴 + tsx（用來直接跑 TypeScript 伺服器）
# 不用 npm ci：倉庫 lockfile 偶有不同步，雲端建置會失敗
RUN npm install --omit=dev --no-audit --no-fund \
  && npm install --no-save --no-audit --no-fund tsx@4.20.5

COPY tsconfig.json ./
COPY server ./server
COPY lib ./lib

ENV NODE_ENV=production
ENV POKER_ALLOW_ANON=0
# Railway / 雲端會覆寫 PORT
ENV PORT=3101

EXPOSE 3101

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3101)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "server/gameServer.ts"]
